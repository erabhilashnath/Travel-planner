# Postgres connection string (Neon). Get from https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="" # generate with: npx auth secret
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Flight/hotel search provider. "mock" works with no keys; "amadeus" requires credentials below.
FLIGHT_PROVIDER="mock"
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
